<Window x:Class="FileManager.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileManager Setup"
        Width="900"
        Height="700"
        MinWidth="820"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4EF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20252B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#D8D2C6"/>
            <Setter Property="Background" Value="#FFFEFB"/>
            <Setter Property="Foreground" Value="#20252B"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8D2C6"/>
            <Setter Property="Background" Value="#FFFEFB"/>
            <Setter Property="Foreground" Value="#20252B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#20252B"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FileManager Setup"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Choose where the app and search database live, then build the first local index."
                           Margin="0,8,0,0"
                           Foreground="#6D747C"
                           FontSize="14"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="12,8"
                    CornerRadius="6"
                    BorderBrush="#C9E3DE"
                    BorderThickness="1"
                    Background="#EAF7F3">
                <TextBlock Text="Local-only search"
                           Foreground="#0F766E"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#E0DBD1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFEFB"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Install location"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="The desktop app files are copied here."
                               Margin="0,4,0,10"
                               Foreground="#6D747C"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathTextBox"
                                 TextChanged="InstallPathTextBox_TextChanged"/>
                        <Button Grid.Column="2"
                                Content="Browse"
                                Click="BrowseInstallPath_Click"/>
                    </Grid>

                    <TextBlock Text="Database location"
                               Margin="0,22,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="The SQLite index can be stored outside the app folder."
                               Margin="0,4,0,10"
                               Foreground="#6D747C"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DatabasePathTextBox"
                                 TextChanged="DatabasePathTextBox_TextChanged"/>
                        <Button Grid.Column="2"
                                Content="Browse"
                                Click="BrowseDatabasePath_Click"/>
                    </Grid>

                    <CheckBox x:Name="DesktopShortcutCheckBox"
                              Content="Create desktop shortcut"
                              IsChecked="True"
                              Margin="0,22,0,0"/>
                    <CheckBox x:Name="LaunchAfterInstallCheckBox"
                              Content="Open FileManager after installation"
                              IsChecked="True"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#E0DBD1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFEFB"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Initial index"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Selected folders are scanned during installation."
                                   Margin="0,4,0,10"
                                   Foreground="#6D747C"/>
                    </StackPanel>

                    <ListBox x:Name="IndexFolderList"
                             Grid.Row="1"
                             Margin="0,4,0,12"
                             BorderBrush="#D8D2C6"
                             Background="#FFFEFB"
                             MinHeight="190"/>

                    <StackPanel Grid.Row="2">
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Add folder"
                                    Margin="0,0,8,0"
                                    Click="AddIndexFolder_Click"/>
                            <Button Content="Remove selected"
                                    Click="RemoveIndexFolder_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="RunInitialIndexCheckBox"
                                  Content="Run initial indexing during install"
                                  IsChecked="True"/>
                        <CheckBox x:Name="SmartCategorizationCheckBox"
                                  Content="Enable smart search and automatic categorization for these folders"
                                  IsChecked="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#E0DBD1"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FFFEFB"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready to install."
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="CountTextBlock"
                           Grid.Column="1"
                           Text=""
                           Foreground="#6D747C"/>
                <ProgressBar x:Name="InstallProgressBar"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Height="8"
                             Margin="0,12,0,12"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#E6E0D4"
                             Foreground="#0F766E"/>
                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click"/>
                    <Button x:Name="InstallButton"
                            Content="Install"
                            Style="{StaticResource PrimaryButton}"
                            Click="InstallButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
